# ─── Trace-Lit Environment Configuration ─────────────────────────────
# Copy this file to .env and fill in your API keys.

# ─── macOS: Required to prevent OpenMP crash (torch + faiss both bundle libomp)
# This MUST be set before Python starts — setting it here has no effect.
# Use `make dev` (sets it automatically), or add to your shell profile:
#   echo 'export KMP_DUPLICATE_LIB_OK=TRUE' >> ~/.zshrc && source ~/.zshrc

# App
APP_NAME=Trace-Lit
DEBUG=true

# Database (SQLite — local-first)
DATABASE_URL=sqlite+aiosqlite:///./data/trace_lit.db

# LLM API Keys
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# LLM Settings
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_BASE=1.0
LLM_TEMPERATURE=0.3

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage paths
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
FAISS_INDEX_DIR=./data/faiss_indexes
