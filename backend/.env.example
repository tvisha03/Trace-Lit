DEBUG=true

DATABASE_URL=sqlite+aiosqlite:///./data/trace_lit.db

GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

USE_LOCAL_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
LLM_RATE_LIMIT_COOLDOWN_SECONDS=60

# Ollama Cloud (https://ollama.com/settings/keys for API key)
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=qwen3.5:397b
OLLAMA_CLOUD_VISION_MODEL=qwen3-vl:235b

# --- Embedding, Reranker & Keyword Models ---
# ⚠️  WARNING: Changing EMBEDDING_MODEL also requires changing EMBEDDING_DIMENSIONS
#     to match, AND deleting data/faiss_indexes/ before restarting so the FAISS
#     index is rebuilt at the correct dimension.  Mixing them causes a crash.
#
# Default (Windows / Linux / any machine with ≥16 GB RAM or a CUDA GPU):
EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
EMBEDDING_DIMENSIONS=1024
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
KEYBERT_MODEL=all-mpnet-base-v2
#
# Lower-RAM alternative (Mac M1/M2 8 GB, or any machine with < 16 GB RAM):
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   EMBEDDING_DIMENSIONS=384
#   CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
#   KEYBERT_MODEL=all-MiniLM-L6-v2

CORS_ORIGINS=[]
